# Solana RPC (Helius devnet; scripts fall back to https://api.devnet.solana.com)
RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_NEW_KEY

# Wallets for the test-covenant scripts (default ~/.config/solana/id.json)
COVENANT_USER_KEYPAIR=
COVENANT_EXECUTOR_KEYPAIR=

# Test-covenant parameters
# collateral amount in tokens (default 1000)
COVENANT_COLLATERAL=
# deadline offset in seconds (default 604800 = 7 days)
COVENANT_DEADLINE_SECONDS=
# covenant hash used when no CLI arg is passed (create/accept/settle)
COVENANT_HASH=

# Set to any value to enable verbose sim logging in negative-tests.ts
DEBUG_LOGS=
