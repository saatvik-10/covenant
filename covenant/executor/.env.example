# Solana RPC used by the executor (e.g. Helius devnet URL)
RPC_URL=
# LayerZero RPC (default https://sepolia-rollup.arbitrum.io/rpc)
LZ_RPC=
# Verifier contract (default: recorded demo address)
VERIFIER_ADDRESS=0xFeB7204dc23609623bF1C0A09fccF3F625d3ACfc
# GMX executor EOA (default: recorded demo value)
GMX_EXECUTOR=0x0Ac16B86d0396Bb7558f144fBb9FbbB91857ff4b
# USD threshold in 30-decimals fixed point (default 5000)
THRESHOLD_USD=
# Poll interval in ms (default 20000)
POLL_MS=
# Solana user wallet (default ~/.config/solana/id.json)
COVENANT_USER_KEYPAIR=
